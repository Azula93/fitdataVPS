# Copia este archivo como env/.env y rellena los valores reales
# NUNCA commitees el archivo .env con datos reales

# Entorno: development | production
NODE_ENV=development

DB_HOST=
DB_USER=
DB_PASSWORD=
DB_NAME=
PORT=3000
DB_PORT=5432

# Secreto para sesiones — usa una cadena larga y aleatoria (mínimo 32 caracteres)
SESSION_SECRET=

# Secreto JWT — usa una cadena larga y aleatoria (mínimo 32 caracteres)
JWT_SECRETO=
JWT_TIEMPO_EXPIRA=1h
JWT_COOKIE_EXPIRA=1
