<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="csrf-token" content="<%= typeof csrfToken !== 'undefined' ? csrfToken : '' %>">
    <meta name="google-adsense-account" content="ca-pub-9371741460887435">
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9371741460887435" crossorigin="anonymous"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap"></noscript>
    <link href="/public/css/tools.css" rel="stylesheet">
    <link rel="icon" href="/public/assets/favicons/logoFD.webp" type="image/x-icon">
    <title>Gasto Energético y Macronutrientes | FitData</title>
</head>
<body>

<!-- ── NAVBAR ── -->
<nav class="tool-nav">
    <% if (user) { %>
        <a href="/panelcontrol" class="nav-logo">Fit<span>Data</span></a>
        <ul class="nav-links">
            <li><a href="/indicesantr">Herramientas</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/misdatos">Mis datos</a></li>
        </ul>
        <a href="/panelcontrol" class="nav-cta">Mi panel →</a>
    <% } else { %>
        <a href="/" class="nav-logo">Fit<span>Data</span></a>
        <ul class="nav-links">
            <li><a href="/#herramientas">Herramientas</a></li>
            <li><a href="/blog">Blog</a></li>
            <li><a href="/login">Iniciar sesión</a></li>
        </ul>
        <a href="/register" class="nav-cta">Empieza gratis →</a>
    <% } %>
</nav>

<!-- ── TOOL HEADER ── -->
<div class="tool-header" id="get">
    <div class="breadcrumb-nav">
        <a href="/">Inicio</a>
        <span class="breadcrumb-sep">›</span>
        <span>Valoración Nutricional</span>
    </div>
    <div class="tool-badge">🔥 Nutrición</div>
    <h1>Gasto Energético Total<br>y Macronutrientes</h1>
    <p>Calcula cuántas calorías necesitas cada día según tu nivel de actividad física, y descubre la distribución ideal de proteínas, carbohidratos y grasas para tus objetivos.</p>
</div>

<!-- ── GET — MAIN CONTENT ── -->
<div class="tool-main">

    <!-- FORMULARIO GET -->
    <div class="form-panel">
        <h2>Gasto Energético Total (GET)</h2>
        <form id="get-form" action="" method="" autocomplete="off">
            <div class="form-group">
                <label>Sexo</label>
                <div class="radio-group">
                    <label class="radio-option">
                        <input type="radio" name="genero" value="mujer"> Femenino
                    </label>
                    <label class="radio-option">
                        <input type="radio" name="genero" value="hombre"> Masculino
                    </label>
                </div>
            </div>
            <div class="form-group">
                <label for="talla">Altura (cm)</label>
                <input type="number" id="talla" placeholder="Ej: 170" min="2" max="250" oninput="limitarNumero(this, 3)">
                <div class="form-error" id="errorMensajeTalla"></div>
            </div>
            <div class="form-group">
                <label for="peso">Peso (kg)</label>
                <input type="number" id="peso" placeholder="Ej: 70" min="2" max="300" oninput="limitarNumero(this, 3)">
                <div class="form-error" id="errorMensajePeso"></div>
            </div>
            <div class="form-group">
                <label for="edad">Edad (años)</label>
                <input type="number" id="edad" placeholder="Ej: 25" min="1" max="99" oninput="limitarNumero(this, 2)">
                <div class="form-error" id="errorMensajeEdad"></div>
            </div>
            <div class="form-group">
                <label>Nivel de actividad física semanal</label>
                <div class="activity-list">
                    <label class="activity-option">
                        <input type="radio" name="factorActividad" value="Menos de 3 horas semanales" id="regular">
                        <div><div class="activity-label">Inactivo</div><div class="activity-desc">Menos de 3 horas semanales</div></div>
                    </label>
                    <label class="activity-option">
                        <input type="radio" name="factorActividad" value="3 Horas semanales">
                        <div><div class="activity-label">Regularmente activo</div><div class="activity-desc">3 horas semanales</div></div>
                    </label>
                    <label class="activity-option">
                        <input type="radio" name="factorActividad" value="6 Horas semanales" id="activo">
                        <div><div class="activity-label">Activo</div><div class="activity-desc">6 horas semanales</div></div>
                    </label>
                    <label class="activity-option">
                        <input type="radio" name="factorActividad" value="4-5 horas Diarias" id="altoRendimiento">
                        <div><div class="activity-label">Alto rendimiento</div><div class="activity-desc">Más de 25 horas semanales</div></div>
                    </label>
                </div>
            </div>
            <button type="submit" class="btn-calc" id="mostrarSeleccion">Calcular mi GET →</button>
        </form>
    </div>

    <!-- RESULTADO GET -->
    <div class="result-panel">
        <div class="result-card-main" id="resultGet">
            <div class="result-placeholder">
                <div class="result-placeholder-icon">🔥</div>
                <p>Completa el formulario para ver tu gasto energético</p>
            </div>
        </div>
        <p id="errorGet" class="form-error"></p>
        <% if (user) { %>
        <div class="result-info" id="save-get-hint" style="display:none">
            💾 <a href="/misdatos">Ve a Mis datos</a> para ver el historial guardado
        </div>
        <% } else { %>
        <div class="result-info" id="save-get-hint" style="display:none">
            💾 <a href="/register">Crea una cuenta gratis</a> para guardar tu resultado
        </div>
        <% } %>
    </div>
</div>

<!-- ── ANUNCIO MEDIO ── -->
<div class="ad-section">
    <div class="ad-label">Publicidad</div>
    <ins class="adsbygoogle" style="display:block"
         data-ad-client="ca-pub-9371741460887435"
         data-ad-slot="auto" data-ad-format="horizontal"
         data-full-width-responsive="true"></ins>
    <script>(adsbygoogle = window.adsbygoogle || []).push({});</script>
</div>

<!-- ── MACRONUTRIENTES — MAIN CONTENT ── -->
<div class="tool-main" style="padding-top:0">

    <!-- FORMULARIO MACRO -->
    <div class="form-panel">
        <h2>Macronutrientes Diarios</h2>
        <p style="font-size:.85rem; color:var(--gray); margin-bottom:1.2rem">Primero calcula tu GET arriba, luego selecciona tu perfil para obtener la distribución de macros.</p>
        <form id="macro-form" action="" method="" autocomplete="off">
            <div class="form-group">
                <label>Perfil de actividad</label>
                <div class="radio-group">
                    <label class="radio-option">
                        <input type="radio" name="Deportista" id="deportista" value="Deportista"> Deportista
                    </label>
                    <label class="radio-option">
                        <input type="radio" name="Deportista" value="No deportista" id="noDeportista"> No deportista
                    </label>
                </div>
            </div>
            <p id="opcionSeleccionada" style="font-size:.8rem; color:var(--gray)"></p>
            <button type="submit" class="btn-calc">Calcular mis macros →</button>
        </form>
    </div>

    <!-- RESULTADO MACRO -->
    <div class="result-panel">
        <div class="result-card-main" id="resultMacro">
            <div class="result-placeholder">
                <div class="result-placeholder-icon">🥗</div>
                <p>Calcula primero tu GET y luego selecciona tu perfil</p>
            </div>
        </div>
        <p id="errorMacro" class="form-error"></p>
        <div class="result-info" style="display:block">
            📖 Descubre más sobre alimentación en nuestro <a href="/blog">Blog</a>
        </div>
    </div>
</div>

<!-- ── HERRAMIENTAS RELACIONADAS ── -->
<div class="related-section">
    <h3>Otras herramientas</h3>
    <div class="related-grid">
        <a href="/indicesantr" class="related-card">
            <span class="related-icon">⚖️</span>
            <div><div class="related-name">IMC</div><div class="related-desc">Índice de Masa Corporal</div></div>
        </a>
        <a href="/icc" class="related-card">
            <span class="related-icon">📏</span>
            <div><div class="related-name">ICC</div><div class="related-desc">Riesgo cardiovascular</div></div>
        </a>
        <a href="/pruebaEsfuerzo" class="related-card">
            <span class="related-icon">🫁</span>
            <div><div class="related-name">VO₂ Máximo</div><div class="related-desc">Capacidad aeróbica</div></div>
        </a>
        <a href="/blog" class="related-card">
            <span class="related-icon">📝</span>
            <div><div class="related-name">Blog</div><div class="related-desc">Artículos de nutrición</div></div>
        </a>
    </div>
</div>

<!-- ── FOOTER ── -->
<footer class="tool-footer">
    <div class="footer-grid">
        <div class="footer-brand">
            <a href="/" class="nav-logo">Fit<span>Data</span></a>
            <p>Herramientas científicas de evaluación física para todos.</p>
        </div>
        <div class="footer-col">
            <h4>Herramientas</h4>
            <a href="/indicesantr">IMC</a>
            <a href="/icc">ICC</a>
            <a href="/pruebaEsfuerzo">VO₂ Máximo</a>
            <a href="/valoracion">Gasto Energético</a>
        </div>
        <div class="footer-col">
            <h4>Legal</h4>
            <a href="/privacyPolicy">Privacidad</a>
            <a href="/avisoLegal">Aviso legal</a>
            <a href="/politicacookies">Cookies</a>
            <a href="/contact">Contacto</a>
        </div>
    </div>
    <div class="footer-bottom">&copy; 2026 FitData. Todos los derechos reservados.</div>
</footer>

<script>
document.getElementById('get-form').addEventListener('submit', function() {
    const hint = document.getElementById('save-get-hint');
    if (hint) hint.style.display = 'block';
});
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/public/js/valnut.js"></script>
</body>
</html>
