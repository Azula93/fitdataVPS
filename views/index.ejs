<script>
document.getElementById('btn-calc-imc').addEventListener('click', calcularIMC);
function calcularIMC() {
    const peso   = parseFloat(document.getElementById('demo-peso').value);
    const altCm  = parseFloat(document.getElementById('demo-altura').value);
    const altura = altCm / 100;

    if (!peso || !altura || peso < 30 || altura < 1) {
        document.getElementById('imc-categoria').textContent = 'Ingresa datos válidos';
        return;
    }

    const imc = (peso / (altura * altura)).toFixed(1);
    let categoria, desc, color, pct;

    if      (imc < 18.5) { categoria = 'Bajo peso';       desc = 'Tu peso está por debajo del rango saludable.';     color = '#3b82f6'; pct = 20; }
    else if (imc < 25)   { categoria = '✓ Peso normal';   desc = '¡Felicidades! Tu peso está en el rango saludable.'; color = '#22c55e'; pct = 50; }
    else if (imc < 30)   { categoria = 'Sobrepeso';        desc = 'Tu peso está ligeramente por encima del rango.';   color = '#f59e0b'; pct = 72; }
    else                 { categoria = 'Obesidad';          desc = 'Se recomienda consultar con un profesional.';      color = '#ef4444'; pct = 90; }

    document.getElementById('imc-valor').textContent      = imc;
    document.getElementById('imc-categoria').textContent  = categoria;
    document.getElementById('imc-categoria').style.color  = color;
    document.getElementById('imc-desc').textContent       = desc;
    document.getElementById('save-prompt').style.display  = 'block';

    // Animar gauge
    const r = 70, cx = 90, cy = 80;
    const angle = -180 + (pct / 100) * 180;
    const rad = (angle * Math.PI) / 180;
    const x = cx + r * Math.cos(rad);
    const y = cy + r * Math.sin(rad);
    const large = pct > 50 ? 1 : 0;
    document.getElementById('gauge-fill').setAttribute('d',
        `M 20 80 A 70 70 0 ${large} 1 ${x.toFixed(1)} ${y.toFixed(1)}`);
    document.getElementById('gauge-fill').style.stroke = color;
}
</script>
