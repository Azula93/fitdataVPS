<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta name="google-adsense-account" content="ca-pub-9371741460887435">
    <meta name="description" content="Crea tu cuenta en FitData gratis y accede a herramientas científicas de evaluación física.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap" media="print" onload="this.media='all'">
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700;800&display=swap"></noscript>
    <link rel="icon" href="/public/assets/favicons/logoFD.webp" type="image/x-icon">
    <title>Crear Cuenta | FitData</title>
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        :root {
            --green: #22c55e;
            --green-dark: #16a34a;
            --green-soft: #dcfce7;
            --dark: #0f172a;
            --gray: #64748b;
            --light: #f8fafc;
            --border: #e2e8f0;
            --radius: 16px;
            --shadow: 0 4px 24px rgba(0,0,0,.08);
        }
        body {
            font-family: 'Poppins', sans-serif;
            background: linear-gradient(135deg, #f0fdf4 0%, #eff6ff 100%);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 2rem 1rem;
        }

        /* ── CARD ── */
        .auth-card {
            background: white;
            border-radius: var(--radius);
            border: 2px solid var(--border);
            box-shadow: var(--shadow);
            width: 100%;
            max-width: 420px;
            padding: 2.5rem 2rem;
        }

        /* ── LOGO ── */
        .auth-logo {
            display: block;
            text-align: center;
            text-decoration: none;
            font-size: 1.8rem;
            font-weight: 800;
            color: var(--dark);
            margin-bottom: 1.8rem;
        }
        .auth-logo span { color: var(--green); }

        /* ── TITLE ── */
        .auth-title {
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--dark);
            text-align: center;
            margin-bottom: .4rem;
        }
        .auth-subtitle {
            font-size: .88rem;
            color: var(--gray);
            text-align: center;
            margin-bottom: 1.8rem;
        }

        /* ── FORM ── */
        .auth-form { display: flex; flex-direction: column; gap: 1rem; }

        .field-group { display: flex; flex-direction: column; gap: .4rem; }
        .field-group label {
            font-size: .82rem;
            font-weight: 600;
            color: var(--dark);
        }
        .field-group input {
            width: 100%;
            padding: .75rem 1rem;
            border: 2px solid var(--border);
            border-radius: 10px;
            font-family: 'Poppins', sans-serif;
            font-size: .92rem;
            color: var(--dark);
            outline: none;
            transition: border-color .2s;
            background: var(--light);
        }
        .field-group input:focus { border-color: var(--green); background: white; }
        .field-group input::placeholder { color: #94a3b8; }

        /* ── SUBMIT ── */
        .btn-submit {
            width: 100%;
            padding: .85rem;
            background: var(--green);
            color: white;
            border: none;
            border-radius: 10px;
            font-family: 'Poppins', sans-serif;
            font-size: .95rem;
            font-weight: 700;
            cursor: pointer;
            transition: background .2s, transform .15s;
            margin-top: .4rem;
        }
        .btn-submit:hover { background: var(--green-dark); transform: translateY(-1px); }
        .btn-submit:active { transform: translateY(0); }

        /* ── DIVIDER ── */
        .auth-divider {
            text-align: center;
            color: var(--gray);
            font-size: .82rem;
            margin: 1.2rem 0;
            position: relative;
        }
        .auth-divider::before, .auth-divider::after {
            content: '';
            position: absolute;
            top: 50%;
            width: 38%;
            height: 1px;
            background: var(--border);
        }
        .auth-divider::before { left: 0; }
        .auth-divider::after { right: 0; }

        /* ── LINKS ── */
        .auth-link-box {
            background: var(--green-soft);
            border-radius: 10px;
            padding: 1rem;
            text-align: center;
        }
        .auth-link-box p { font-size: .88rem; color: var(--gray); margin-bottom: .5rem; }
        .auth-link-btn {
            display: inline-block;
            padding: .6rem 1.4rem;
            background: white;
            border: 2px solid var(--green);
            border-radius: 8px;
            color: var(--green-dark);
            font-weight: 700;
            font-size: .88rem;
            text-decoration: none;
            transition: background .2s, color .2s;
        }
        .auth-link-btn:hover { background: var(--green); color: white; }

        .auth-back {
            display: block;
            text-align: center;
            margin-top: 1.2rem;
            font-size: .82rem;
            color: var(--gray);
            text-decoration: none;
        }
        .auth-back:hover { color: var(--green-dark); }
    </style>
</head>
<body>

<div class="auth-card">
    <a href="/" class="auth-logo">Fit<span>Data</span></a>

    <h1 class="auth-title">Crea tu cuenta gratis</h1>
    <p class="auth-subtitle">Empieza a evaluar tu condición física hoy</p>

    <form id="formRegister" action="/register" method="POST" class="auth-form">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">

        <div class="field-group">
            <label for="nombreUsuario">Nombre completo</label>
            <input type="text" id="nombreUsuario" name="nombreUsuario" placeholder="Tu nombre" required>
        </div>

        <div class="field-group">
            <label for="email">Correo electrónico</label>
            <input type="email" id="email" name="email" placeholder="tu@correo.com" required>
        </div>

        <div class="field-group">
            <label for="pass">Contraseña</label>
            <input type="password" id="pass" name="pass" placeholder="••••••••" required>
        </div>

        <div class="field-group">
            <label for="pass2">Repite la contraseña</label>
            <input type="password" id="pass2" name="pass2" placeholder="••••••••" required>
        </div>

        <button type="submit" class="btn-submit">Crear cuenta →</button>
    </form>

    <div class="auth-divider">o</div>

    <div class="auth-link-box">
        <p>¿Ya tienes una cuenta?</p>
        <a href="/login" class="auth-link-btn">Iniciar sesión</a>
    </div>

    <a href="/" class="auth-back">← Volver al inicio</a>
</div>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<% if(alert) { %>
<script>
    Swal.fire({
        title: <%- JSON.stringify(alertTitle) %>,
        text: <%- JSON.stringify(alertMessage) %>,
        icon: <%- JSON.stringify(alertIcon) %>,
        showConfirmButton: <%= showConfirmButton %>,
        timer: <%= timer %>
    }).then(() => {
        window.location = <%- JSON.stringify(ruta) %>
    })
</script>
<% } %>

</body>
</html>
