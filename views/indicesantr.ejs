        </div>
    </div>
    <div class="footer-bottom">&copy; 2026 FitData. Todos los derechos reservados.</div>
</footer>

<script>
document.getElementById('imc-form').addEventListener('submit', function() {
    document.getElementById('save-imc-hint').style.display = 'block';
});
</script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="/public/js/antropometria.js"></script>
</body>
</html>
